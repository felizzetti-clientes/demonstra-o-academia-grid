# Copie para .env.local (não versionado) ou configure no painel da hospedagem.

# Domínio definitivo do site, sem barra no final. Ex.: https://www.academiagrid.com.br
# Enquanto não for definido, metadados canônicos, sitemap e llms.txt usam http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Mantenha "false" enquanto o site for um protótipo privado (noindex em todo o site).
NEXT_PUBLIC_INDEXAR=false
